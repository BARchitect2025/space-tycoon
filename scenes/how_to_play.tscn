[node name="Label" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1511000804]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Controls"
horizontal_alignment = 1

[node name="Label2" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=354048804]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "To move, you use WASD like most games."
horizontal_alignment = 1

[node name="Label3" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1830346045]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "In this game, however, to turn, you use A and D, not the mouse."
horizontal_alignment = 1

[node name="Label4" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=904250871]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "W and S accelerate forward and backward, respectively."
horizontal_alignment = 1

[node name="Label5" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1676642837]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "To shoot, you press the spacebar, but holding it just shoots once."
horizontal_alignment = 1

[node name="Label6" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1923276058]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Shift toggles between fast and slow turning."
horizontal_alignment = 1

[node name="Label7" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1187008402]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Control toggles your speed mode."
horizontal_alignment = 1

[node name="Label8" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=185493061]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "Gameplay"
horizontal_alignment = 1

[node name="Label9" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=665298846]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Your goal is to survive as many waves as possible."
horizontal_alignment = 1

[node name="Label10" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1811178399]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "With each kill, your credits go up and you can buy ship upgrades."
horizontal_alignment = 1

[node name="Label11" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1695665644]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "When you finish a wave, the shop will open for you to spend credits."
horizontal_alignment = 1

[node name="Label12" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=665552323]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "As the number of waves you have survived increases, so does the number of enemies."
horizontal_alignment = 1

[node name="Label13" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1971771347]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "There are mines, which do what any other mine would do (They explode)."
horizontal_alignment = 1

[node name="Label14" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=687483556]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "There are also ships that shoot at you when they get in range."
horizontal_alignment = 1

[node name="Label15" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=1720790896]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "The speed of your lasers scales with the speed that you are traveling."
horizontal_alignment = 1

[node name="Label16" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=557343132]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "What this means is that if you shoot while not moving and then accelerate, you will hit your laser."
horizontal_alignment = 1

[node name="Label17" type="Label" parent="CanvasLayer/UI/ScrollContainer/VBoxContainer" unique_id=2095927181]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "You have the option to turn slow or fast, as well as moving slow or fast."
horizontal_alignment = 1

